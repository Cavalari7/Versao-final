# Copie este arquivo para ".env" (na pasta BACKEND) e preencha. O ".env" NUNCA vai para o GitHub.

# --- Banco de dados: SQLite, arquivo local (BACKEND/dados/bioleo.db), nada para instalar ---
# Para guardar o arquivo em outro lugar: DB_FILE=C:/caminho/bioleo.db

# --- Acesso da equipe (OBRIGATÓRIO em produção): invente uma chave longa ---
ADMIN_KEY=troque-por-uma-chave-longa-e-secreta

# --- Google Maps Platform ---
# Chave do NAVEGADOR (aparece no site, por isso precisa de restrição por domínio).
# Habilite nela somente: Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
# Chave do SERVIDOR (secreta, fica só aqui). Habilite somente: Routes API e Geocoding API.
GOOGLE_MAPS_SERVER_KEY=
# ID do mapa (Google Cloud > Maps Management > Map IDs). Sem ele usa um ID de demonstração.
GOOGLE_MAP_ID=
# Trânsito em tempo real nas rotas (SKU "Pro", mais caro). Padrão: desligado.
# ROTA_COM_TRAFEGO=on

# --- Ponto de partida da equipe (base). Use coordenadas OU endereço ---
# BASE_LAT=-23.6598
# BASE_LNG=-52.6050
BASE_ENDERECO=Rodovia PR-323, Lote 4, Gleba São Januário, Cianorte - PR
BASE_NOME=Bio Óleo / Brasil
# Cidade usada para completar o endereço do cliente na busca
GEOCODE_CIDADE=Cianorte, Paraná

# --- Alternativa gratuita sem Google (só endereço -> mapa) ---
# NOMINATIM_EMAIL=seu-email@exemplo.com
# GEOCODING=off

# Dias para guardar as posições da equipe (LGPD)
# RETENCAO_DIAS=30
